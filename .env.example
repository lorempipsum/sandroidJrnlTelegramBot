# Minimal example .env for telegram_jrnl_bot
# Replace values with your own.

# Telegram
TELEGRAM_BOT_TOKEN="<your-bot-token-here>"
# Optional: restrict messages to a single chat id (owner)
#TELEGRAM_ALLOWED_CHAT_ID=

# Where to write journal and media. If you use rclone mount, point this at the mountpoint.
ONEDRIVE_DIR="/home/youruser/OneDrive"
JOURNAL_FILE_NAME="telegram-jrnl.txt"
MEDIA_SUBDIR="jrnl-media"

# Optional rclone upload instead of a mount
# Set this to your rclone remote prefix (example: onedrive:telegram-jrnl)
#RCLONE_REMOTE="onedrive:telegram-jrnl"
#RCLONE_REMOVE_LOCAL=false

# Polling settings
POLL_TIMEOUT_SECONDS=30
POLL_INTERVAL_SECONDS=2

# Optional timezone for timestamps
#TIMEZONE=America/New_York
